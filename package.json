{
	"name": "project-map-cli",
	"version": "1.0.0",
	"description": "CLI that builds a deterministic PROJECT_MAP.md architectural map and a byte-reproducible detection-facts artifact for a single repository (Python, JS/TS, Go, Java, Kotlin)",
	"license": "MIT",
	"author": "cyberash",
	"type": "module",
	"main": "dist/cli/index.js",
	"bin": {
		"project-map": "dist/cli/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"keywords": [
		"project-map",
		"architecture",
		"tree-sitter",
		"cli",
		"hexagonal",
		"vertical-slice",
		"static-analysis",
		"openapi",
		"spec-driven-development"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cyberash-dev/project-map-cli.git"
	},
	"bugs": {
		"url": "https://github.com/cyberash-dev/project-map-cli/issues"
	},
	"homepage": "https://github.com/cyberash-dev/project-map-cli#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "node scripts/emit-build-digest.mjs && tsc -p tsconfig.build.json && node scripts/mark-bin-executable.mjs",
		"prepublishOnly": "npm run lint && npm run build && npm test",
		"start": "node dist/cli/index.js",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"prettier": "@cyberash-dev/dev-tooling/prettier.base.json",
	"dependencies": {
		"@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
		"commander": "14.0.0",
		"cosmiconfig": "9.0.0",
		"globby": "14.1.0",
		"mdast-util-gfm-table": "2.0.0",
		"mdast-util-to-markdown": "2.1.2",
		"picocolors": "1.1.1",
		"tree-sitter": "0.22.4",
		"tree-sitter-go": "0.23.4",
		"tree-sitter-java": "0.23.5",
		"tree-sitter-javascript": "0.23.1",
		"tree-sitter-python": "0.23.6",
		"tree-sitter-typescript": "0.23.2",
		"yaml": "2.8.1",
		"zod": "4.3.6"
	},
	"devDependencies": {
		"@cyberash-dev/dev-tooling": "5.0.0",
		"@types/mdast": "4.0.4",
		"@types/node": "25.0.10",
		"eslint": "10.4.1",
		"prettier": "3.8.3",
		"typescript": "5.9.3",
		"vitest": "3.2.4"
	},
	"overrides": {
		"tree-sitter-go": {
			"tree-sitter": "$tree-sitter"
		},
		"tree-sitter-java": {
			"tree-sitter": "$tree-sitter"
		},
		"tree-sitter-javascript": {
			"tree-sitter": "$tree-sitter"
		},
		"tree-sitter-typescript": {
			"tree-sitter": "$tree-sitter"
		}
	}
}
