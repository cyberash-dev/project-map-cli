{
	"$schema": "https://github.com/cyberash-dev/sdd-cli/blob/main/schema/sdd.config.schema.json",
	"spec_file": "spec/spec.md",
	"baseline_id": "project-map:BL-001",
	"discovery_scope": [
		"src",
		"tests",
		"scripts/mark-bin-executable.mjs",
		"package.json",
		"tsconfig.json",
		"tsconfig.build.json",
		"vitest.config.ts"
	],
	"footprint": {
		"binding_id_prefix": "IMP-",
		"binding_field": "binding"
	},
	"mechanism": "git_tree_hash_v1",
	"lint": {
		"spec_files": ["spec/spec.md", "spec/detection.md"],
		"approver_blocklist": []
	},
	"partitions": {
		"project-map": {
			"spec_paths": ["spec/spec.md", "spec/detection.md"],
			"test_paths": ["tests/**/*.test.ts"],
			"sandbox_paths": ["spec/detection.md"]
		}
	}
}
